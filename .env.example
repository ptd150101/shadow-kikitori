# Local HTTP services
JLPT_HOST=127.0.0.1
JLPT_PORT=8765
JLPT_DATA_DIR=

# Tools. Leave blank when they are on PATH.
JLPT_FFMPEG_PATH=ffmpeg
JLPT_FFPROBE_PATH=ffprobe
JLPT_YTDLP_PATH=yt-dlp

# Models. The pyannote directory is local after its first gated download.
JLPT_AUDIO8_MODEL_ID=Edge0/Audio8-ASR-0.1B
JLPT_AUDIO8_REVISION=
JLPT_PYANNOTE_MODEL_PATH=
JLPT_HF_TOKEN=
JLPT_DEVICE=auto

# Gemma translation. Set mode to external to reuse an already running llama-server.
JLPT_LLM_MODE=external
JLPT_LLM_BASE_URL=http://127.0.0.1:8080/v1
JLPT_LLM_MODEL=unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
JLPT_LLM_EXECUTABLE=
JLPT_LLM_MODEL_PATH=
JLPT_LLM_PORT=8080

# Guard rails for local imports.
JLPT_MAX_UPLOAD_BYTES=2147483648
JLPT_MAX_DURATION_SECONDS=7200
JLPT_AUDIO8_MAX_SECONDS=28
